{
  "manifest_version": 3,
  "name": "Send to ChatGPT",
  "version": "1.1.0",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "description": "Send selected text, images, or a free-draw screenshot crop to ChatGPT from the right-click menu or the address bar.",
  "permissions": ["contextMenus", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "omnibox": { "keyword": "gpt" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["cursor.js"], "all_frames": true, "run_at": "document_start" },
    { "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["chatgpt.js"], "run_at": "document_idle" }
  ]
}
